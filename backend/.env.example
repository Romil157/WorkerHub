# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/workerhub

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@workerhub.in
SENDGRID_FROM_NAME=WorkerHub

# Twilio (OTP)
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Redis (for Bull queues)
REDIS_URL=redis://localhost:6379

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin
ADMIN_INITIAL_EMAIL=admin@workerhub.in
ADMIN_INITIAL_PASSWORD=Admin@123456

# AI Detection (Sightengine / Hive)
AI_DETECTION_PROVIDER=sightengine
AI_DETECTION_API_USER=your_sightengine_api_user
AI_DETECTION_API_SECRET=your_sightengine_api_secret
AI_DETECTION_SCORE_THRESHOLD=0.7

# OpenRouteService (Route Optimization - free key from openrouteservice.org)
OPENROUTESERVICE_API_KEY=your_ors_api_key
